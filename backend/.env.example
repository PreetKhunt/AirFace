# SIH26056 Production Environment Template
ENVIRONMENT=production
LOG_LEVEL=INFO

# PostgreSQL Configuration
DATABASE_URL=postgresql://user:password@hostname:5432/sih_airfare

# Redis / Celery Configuration
REDIS_URL=redis://hostname:6379/0

# API Configuration
API_BASE_URL=https://your-render-domain.onrender.com

# CORS Configuration (Comma separated list)
CORS_ORIGINS=https://your-vercel-domain.vercel.app,http://localhost:3000

# Feature Flags
SCRAPER_ENABLED=True
DATA_MODE=LIVE
